rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    function currentProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    function platformOperator() {
      return hasProfile() && currentProfile().role in ['super_admin', 'service_operator'];
    }
    function institutionalOperator() {
      return hasProfile() && currentProfile().role in ['group_admin', 'program_operator'];
    }
    function anyOperator() { return platformOperator() || institutionalOperator(); }
    function canManageInstitutionProfile() {
      return institutionalOperator()
        && resource.data.group_id == currentProfile().group_id
        && request.resource.data.group_id == currentProfile().group_id
        && request.resource.data.role in ['program_operator', 'user'];
    }

    match /profiles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || anyOperator());
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == 'user';
      allow update: if platformOperator()
        || canManageInstitutionProfile()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.group_id == resource.data.group_id
          && request.resource.data.project_id == resource.data.project_id);
      allow delete: if false;
    }

    match /diagnosis_records/{id} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || anyOperator());
      allow create: if signedIn() && (request.resource.data.user_id == request.auth.uid || anyOperator());
      allow update, delete: if signedIn() && (resource.data.user_id == request.auth.uid || anyOperator());
    }
    match /diagnosis_results/{id} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || anyOperator());
      allow create: if signedIn() && (request.resource.data.user_id == request.auth.uid || anyOperator());
      allow update, delete: if signedIn() && (resource.data.user_id == request.auth.uid || anyOperator());
    }
    match /questions/{id} { allow read: if true; allow write: if platformOperator(); }
    match /groups/{id} { allow read: if signedIn(); allow write: if platformOperator(); }
    match /projects/{id} { allow read: if signedIn(); allow write: if anyOperator(); }
    match /audit_logs/{id} { allow read: if platformOperator(); allow write: if false; }
    match /{document=**} { allow read, write: if anyOperator(); }
  }
}
